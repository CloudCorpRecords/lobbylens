{
  "bin": {
    "lobbylens": "dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1",
    "zod": "^4"
  },
  "description": "Forward read-only queries to the published Lobbyvo dataset: search rows, look rows up by key, compare values, and pull column statistics and provenance, through one bin that serves both a small CLI and a stdio MCP server.",
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "homepage": "https://github.com/CloudCorpRecords/lobbylens#readme",
  "license": "MIT",
  "mcpName": "io.github.CloudCorpRecords/lobbylens",
  "name": "@reneturcios/lobbylens",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCorpRecords/lobbylens.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "type": "module",
  "version": "0.1.0"
}
